# 기본 설정
PROJECT_NAME=Senior Album API
VERSION=0.2.0
DEBUG=True

# 데이터베이스
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/senior_album

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
JWT_REFRESH_THRESHOLD_MINUTES=1440

# 얼굴 인식
FACE_SIMILARITY_THRESHOLD=0.6
FACE_DETECTION_CONFIDENCE=0.9

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:19006"]

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=senior-album-photos
MINIO_USE_SSL=False

# 로컬 업로드 (MinIO 없을 때 fallback)
UPLOAD_DIR=./uploads

# 외부 URL (프로덕션에서 변경)
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# 공유 링크 만료 (시간)
SHARE_LINK_EXPIRE_HOURS=72

# 로그인 보안
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 카카오 OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# DDL 자동 관리
DDL_AUTO=create
