# 기본 설정
PROJECT_NAME=Senior Album API
VERSION=0.2.0
DEBUG=True

# 데이터베이스 — 부분 env 권장 (k8s 배포 일관성). DATABASE_URL 도 지원 (있으면 우선).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=senior_album
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/senior_album

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 두 가지 주입 방식이 있다 (T-055):
#   (1) 단일 키 — 로컬 dev 권장. JWT_SECRET / JWT_REFRESH_SECRET 만 채우면 됨.
#       토큰 헤더에 kid 미포함, 검증은 'legacy' 키로 처리.
#   (2) Rolling key — 운영. JWT_KEY_<KID> / JWT_REFRESH_KEY_<KID> 다수 +
#       JWT_ACTIVE_KID / JWT_REFRESH_ACTIVE_KID 로 발급용 kid 지정.
#       회전 = 새 kid 추가 → ACTIVE 전환 → grace 후 옛 kid envvar 제거.
# 둘 다 비면 부트 실패.
JWT_SECRET=
JWT_REFRESH_SECRET=
# JWT_KEY_V1=...        # 운영 회전용 — 로컬에선 보통 비워둠
# JWT_REFRESH_KEY_V1=...
# JWT_ACTIVE_KID=v1
# JWT_REFRESH_ACTIVE_KID=v1
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=20160

# 얼굴 인식
FACE_SIMILARITY_THRESHOLD=0.6
FACE_DETECTION_CONFIDENCE=0.9

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
# T-004: 운영(K8s) 에서는 SealedSecret 으로 USE_SSL=true / VERIFY_CERTS=true /
# CA_CERT_PATH + USER/PASSWORD 주입. dev 는 기본값 (평문 9200, 인증 없음) 유지.
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERT_PATH=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:19006"]

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=senior-album-photos
MINIO_USE_SSL=False

# 외부 URL (프로덕션에서 변경)
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# 공유 링크 만료 (시간)
SHARE_LINK_EXPIRE_HOURS=72

# 로그인 보안
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 카카오 OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

